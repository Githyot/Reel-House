{
  "id": "hyperos",
  "look": "android",
  "name": "HyperOS",
  "description": "Xiaomi HyperOS (phones): MiSans type with bold large titles, the HyperOS blue accent, white cards with large rounded corners on a light grey page (black with dark grey cards at night), blue switches with a white knob, a flat bottom bar whose selected place turns blue, and bottom sheets that float clear of the screen edges. Built on the Android components (look: android), so every page behaves like the Android theme.",
  "sources": [
    "https://www.mi.com/global/hyperos/",
    "https://www.mi.com/global/support/user-guide-pdf/za/generic-user-guide-for-hyperos/",
    "https://hyperos.mi.com/font/"
  ],
  "schema": {
    "colors": "Material 3 colour roles beside the shared names: primary/onPrimary/primaryContainer/onPrimaryContainer, secondary..., tertiary..., surface tiers (surfaceDim, surfaceBright, surfaceContainerLowest..Highest), outline/outlineVariant, inverseSurface/inverseOnSurface/inversePrimary, errorContainer/onErrorContainer, and the state layers stateHover (8 %), stateFocus/statePressed (10 %), stateDrag (16 %) of onSurface. The shared names map onto them (window = surface, card = surfaceContainer, popover = surfaceContainerHigh, button = secondaryContainer, accent = primary).",
    "shape": "the M3 corner scale: extraSmall 4, small 8, medium 12, large 16, extraLarge 28 (sheet), full = pill; fab 16.",
    "elevation": "tonal: true = elevation is a surface tint (levels 0..5 name the surface-container tier), no drop shadows.",
    "mobile": "phone metrics read by the pages when Theme.mobile: target 48, rowH 56 (one line) / row2H 72 (two lines), barH 80 (navigation bar), fabSize 56, fabRadius 16, nav bar, dialog fullscreen, fab true, grabber false, minText 14, seekStep 10 s (double tap), navLabel 12, appBarH 64.",
    "look": "android: the components draw the Android controls (back arrow, FAB, dialogs) with HyperOS colours, shapes and type.",
    "mobile.floatingSheet": "true = phone bottom sheets float sheetMargin px from the screen edges, every corner rounded (HyperOS sheets and dialogs).",
    "layout.toggle": "hyper = the HyperOS switch: a pill in the accent colour when on, light grey when off, a white knob."
  },
