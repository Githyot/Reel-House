{
  "id": "android",
  "name": "Android",
  "description": "Material 3 (Android): dynamic-colour roles (primary, secondary and tertiary containers, five surface-container tiers), tonal elevation instead of shadows, 4/8/12/16/28 dp shapes, 48 dp touch targets, state layers, Roboto; on a phone a navigation bar, FABs, full-screen dialogs and 56/72 dp list rows.",
  "sources": [
    "https://developer.android.com/design/ui/mobile",
    "https://developer.android.com/design/ui/mobile/guides/foundations/system-bars",
    "https://developer.android.com/design/ui/mobile/guides/layout-and-content/layout-basics",
    "https://developer.android.com/design/ui/mobile/guides/components/material-overview",
    "https://m3.material.io/styles/color/roles",
    "https://m3.material.io/styles/elevation/overview",
    "https://m3.material.io/styles/shape/corner-radius-scale",
    "https://m3.material.io/foundations/interaction/states/state-layers",
    "https://m3.material.io/foundations/accessible-design/accessibility-basics",
    "https://m3.material.io/components/navigation-bar/specs",
    "https://m3.material.io/components/floating-action-button/specs"
  ],
  "schema": {
    "colors": "Material 3 colour roles beside the shared names: primary/onPrimary/primaryContainer/onPrimaryContainer, secondary..., tertiary..., surface tiers (surfaceDim, surfaceBright, surfaceContainerLowest..Highest), outline/outlineVariant, inverseSurface/inverseOnSurface/inversePrimary, errorContainer/onErrorContainer, and the state layers stateHover (8 %), stateFocus/statePressed (10 %), stateDrag (16 %) of onSurface. The shared names map onto them (window = surface, card = surfaceContainer, popover = surfaceContainerHigh, button = secondaryContainer, accent = primary).",
    "shape": "the M3 corner scale: extraSmall 4, small 8, medium 12, large 16, extraLarge 28 (sheet), full = pill; fab 16.",
    "elevation": "tonal: true = elevation is a surface tint (levels 0..5 name the surface-container tier), no drop shadows.",
    "mobile": "phone metrics read by the pages when Theme.mobile: target 48, rowH 56 (one line) / row2H 72 (two lines), barH 80 (navigation bar), fabSize 56, fabRadius 16, nav bar, dialog fullscreen, fab true, grabber false, minText 14, seekStep 10 s (double tap), navLabel 12, appBarH 64."
  },
