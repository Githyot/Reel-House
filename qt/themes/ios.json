{
  "id": "ios",
  "look": "apple",
  "name": "iOS",
  "description": "iOS Human Interface Guidelines: the system colours (label, fills, grouped backgrounds, separators), the SF text styles at their Dynamic Type sizes (large title 34, body 17, footnote 13), 44 pt targets, inset grouped lists, large titles that collapse, a bottom tab bar, sheets with a grabber; the Apple materials on a desktop.",
  "sources": [
    "https://developer.apple.com/design/human-interface-guidelines/designing-for-ios",
    "https://developer.apple.com/design/human-interface-guidelines/color",
    "https://developer.apple.com/design/human-interface-guidelines/typography",
    "https://developer.apple.com/design/human-interface-guidelines/layout",
    "https://developer.apple.com/design/human-interface-guidelines/tab-bars",
    "https://developer.apple.com/design/human-interface-guidelines/sheets",
    "https://developer.apple.com/design/human-interface-guidelines/lists-and-tables",
    "https://developer.apple.com/design/human-interface-guidelines/materials"
  ],
  "schema": {
    "look": "apple: the components draw the Apple controls (iOS switch, traffic lights on a desktop, the Apple colour chooser) and the app icon of the Apple theme.",
    "colors": "the iOS system colours beside the shared names: label/secondaryLabel/tertiaryLabel/quaternaryLabel (label2..4), systemBackground tiers (view, surface, surface2), systemGroupedBackground (groupedBg) and its cards (groupedCard), separator, the fills (fill, fill2, fill3), tabBar, grabber; accent = systemBlue.",
    "typography": "the SF text styles at the default Dynamic Type size: largeTitle 34/700, title1 28, title2 22, title3 20, headline 17/600, body 17, callout 16, subheadline 15, footnote 13, caption1 12, caption2 11 (typography.textStyles); the UI roles below are the desktop sizes, typography.mobile the phone sizes.",
    "mobile": "phone metrics read by the pages when Theme.mobile: target 44, rowH 44 / row2H 60, barH 49 (tab bar, plus the home-indicator inset), nav tab-bar, dialog sheet (full height, grabber), fab false (the primary action stays in the bar), minText 14, seekStep 10 s, navLabel 11, appBarH 44."
  },
