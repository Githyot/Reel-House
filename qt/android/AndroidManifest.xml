<?xml version="1.0"?>
<!-- Package source of the Android build (QT_ANDROID_PACKAGE_SOURCE_DIR in qt/CMakeLists.txt). androiddeployqt fills the
     "%%INSERT_...%%" marks; the SDK levels come from the CMake target properties (min 28, target 34). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.reelhouse.app"
          android:installLocation="auto"
          android:versionCode="-- %%INSERT_VERSION_CODE%% --"
          android:versionName="-- %%INSERT_VERSION_NAME%% --">

    <!-- catalogues, streams, covers, cloud backup -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- the video keeps playing with the screen on; the player sets FLAG_KEEP_SCREEN_ON through Platform.keepScreenOn -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- the user's own files (local videos, EPUBs, backups) on Android 9 and 10; from 11 on the app reads through the
         picker (content:// URIs) and keeps its own data in its private folder -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <!-- the microphone of Conversation (MicRecorder.qml); asked at run time -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- torrents and downloads that go on while another app is in front (a foreground service, later) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- updates of the app (controller_update.rs): the downloaded APK goes to the system installer, which asks the user -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- phones, tablets and Android TV (the leanback launcher below); none of these is required -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>

    <supports-screens android:anyDensity="true" android:largeScreens="true" android:normalScreens="true" android:smallScreens="true"/>

    <application android:name="org.qtproject.qt.android.bindings.QtApplication"
                 android:hardwareAccelerated="true"
                 android:label="ReelHouse"
                 android:icon="@mipmap/ic_launcher"
                 android:roundIcon="@mipmap/ic_launcher_round"
                 android:banner="@drawable/banner"
                 android:theme="@style/ReelHouseTheme"
                 android:allowBackup="true"
                 android:fullBackupOnly="false"
                 android:requestLegacyExternalStorage="true"
                 android:allowNativeHeapPointerTagging="false"
                 android:usesCleartextTraffic="true">

        <activity android:name="org.qtproject.qt.android.bindings.QtActivity"
                  android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
                  android:label="ReelHouse"
                  android:launchMode="singleTop"
                  android:screenOrientation="unspecified"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Android TV home screen -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>

            <meta-data android:name="android.app.lib_name" android:value="-- %%INSERT_APP_LIB_NAME%% --"/>
            <meta-data android:name="android.app.arguments" android:value=""/>
            <!-- the app draws its own controls: nothing of the Android style is needed -->
            <meta-data android:name="android.app.extract_android_style" android:value="minimal"/>
            <!-- the loading screen while Qt starts: dark, the macaw's disc centred at its own size (drawable/splash.xml);
                 LoadingScreen.qml takes over with the same picture until the first page has its data -->
            <meta-data android:name="android.app.splash_screen_drawable" android:resource="@drawable/splash"/>
            <meta-data android:name="android.app.splash_screen_sticky" android:value="false"/>
        </activity>

        <!-- content:// addresses for files of the app: the APK of an update (Platform::installApk) and files Qt opens
             with QDesktopServices. The authority is the one Qt uses ("<package>.qtprovider"). -->
        <provider android:name="androidx.core.content.FileProvider"
                  android:authorities="org.reelhouse.app.qtprovider"
                  android:exported="false"
                  android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/qtprovider_paths"/>
        </provider>
    </application>
</manifest>
